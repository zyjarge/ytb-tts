{
  "manifest_version": 3,
  "name": "YouTube 中文配音",
  "version": "0.1.0",
  "description": "将 YouTube 视频英文字幕实时翻译并合成中文语音,与原画面同步播放,提升观看学习效率",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "https://api.minimaxi.chat/*",
    "https://api.minimaxi.com/*",
    "https://api-bj.minimaxi.com/*",
    "https://api.deepseek.com/*",
    "*://*.minimaxi.com/*",
    "*://*.minimaxi.chat/*",
    "*://*.minimax.chat/*",
    "*://api.bilibili.com/*",
    "*://*.hdslb.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "lib/subtitles.js",
        "lib/syncplayer.js",
        "lib/dubcommon.js",
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.bilibili.com/video/*"
      ],
      "js": [
        "lib/syncplayer.js",
        "lib/dubcommon.js",
        "bilibili.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "icons/button.png"
      ],
      "matches": [
        "*://www.youtube.com/*",
        "*://www.bilibili.com/*"
      ]
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
